+// World-map persistence: one saved ARWorldMap (NSKeyedArchiver) plus an opaque metadata
+// string JS owns (e.g. notes keyed by anchor id), both under Documents/ExpoArWorldMap/.
+// Written together so the map and its metadata never drift apart.
+enum ExpoArWorldMapStore {
+  private static var directory: URL {
+    FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+      .appendingPathComponent("ExpoArWorldMap", isDirectory: true)
+  }
+  private static var mapURL: URL { directory.appendingPathComponent("worldmap.arexperience") }
+  private static var metadataURL: URL { directory.appendingPathComponent("metadata.json") }
+
+  static func save(_ map: ARWorldMap, metadata: String) throws {
+    let data = try NSKeyedArchiver.archivedData(withRootObject: map, requiringSecureCoding: true)
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+    try data.write(to: mapURL, options: .atomic)
+    try Data(metadata.utf8).write(to: metadataURL, options: .atomic)
+  }
+
+  static func loadMap() -> ARWorldMap? {
+    guard let data = try? Data(contentsOf: mapURL) else { return nil }
+    return try? NSKeyedUnarchiver.unarchivedObject(ofClass: ARWorldMap.self, from: data)
+  }
+
+  static func loadMetadata() -> String? {
+    try? String(contentsOf: metadataURL, encoding: .utf8)
+  }
+
+  static func clear() {
+    try? FileManager.default.removeItem(at: directory)
+  }
+}
