+    halo.firstMaterial?.lightingModel = .constant
+    halo.firstMaterial?.diffuse.contents = color.withAlphaComponent(0.3)
+    halo.firstMaterial?.blendMode = .add
+    halo.firstMaterial?.writesToDepthBuffer = false
