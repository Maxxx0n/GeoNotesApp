+  // MARK: - LiDAR occlusion
+  // ARSCNView doesn't occlude virtual content with the reconstructed mesh on its own. Each
+  // ARMeshAnchor gets an invisible, depth-only copy of its mesh, so anything behind real
+  // geometry fails the depth test. Mesh anchors only exist while scene reconstruction runs
+  // (depthEnabled on a LiDAR device). The copy is pushed this far into the surface along the
+  // vertex normals so content ON the surface (wall drawings 3 mm off, plane overlays,
+  // half-buried markers) isn't eaten by mesh noise.
+  private static let occluderNodeName = "expoAr.occluder"
+  private static let occluderInset: Float = 0.03
+
+  /// Copies vertices (ARKit reuses its Metal buffers) and builds a depth-only geometry.
+  private func occluderGeometry(_ mesh: ARMeshGeometry) -> SCNGeometry {
+    let vertices = mesh.vertices
+    let normals = mesh.normals
+    let vBase = vertices.buffer.contents().advanced(by: vertices.offset)
+    let nBase = normals.buffer.contents().advanced(by: normals.offset)
+    var points = [SCNVector3]()
+    points.reserveCapacity(vertices.count)
+    for i in 0..<vertices.count {
+      let v = vBase.advanced(by: i * vertices.stride).assumingMemoryBound(to: Float.self)
+      let n = nBase.advanced(by: i * normals.stride).assumingMemoryBound(to: Float.self)
+      let inset = Self.occluderInset
+      points.append(SCNVector3(v[0] - n[0] * inset, v[1] - n[1] * inset, v[2] - n[2] * inset))
+    }
+    let faces = mesh.faces
+    let indexData = Data(
+      bytes: faces.buffer.contents(),
+      count: faces.count * faces.indexCountPerPrimitive * faces.bytesPerIndex)
+    let element = SCNGeometryElement(
+      data: indexData, primitiveType: .triangles, primitiveCount: faces.count,
+      bytesPerIndex: faces.bytesPerIndex)
+    let geometry = SCNGeometry(sources: [SCNGeometrySource(vertices: points)], elements: [element])
+    let material = SCNMaterial()
+    material.colorBufferWriteMask = []
+    material.writesToDepthBuffer = true
+    material.isDoubleSided = true
+    geometry.materials = [material]
+    return geometry
+  }
